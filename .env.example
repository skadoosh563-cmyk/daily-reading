# ============================================================
#  本地测试用的环境变量模板
#  用法：复制成 .env 再填自己的值
#      cp .env.example .env
#  注意：.env 已在 .gitignore 里，不会被提交
#  在 GitHub Actions 上跑时，这几个值放到仓库 Secrets 里
# ============================================================

# 大模型 API Key（DeepSeek / 月之暗面 / 智谱 / 通义… 任选其一）
LLM_API_KEY=

# 可选：临时覆盖 config.yaml 里的 base_url 和 model（不填就用 config.yaml 的）
# LLM_BASE_URL=
# LLM_MODEL=

# 邮件推送（不需要邮件推送可以不填，用 --no-email 跑）
SMTP_SENDER=          # 发件邮箱，如 you@qq.com
SMTP_PASSWORD=        # SMTP 授权码（不是登录密码）
SMTP_RECEIVER=        # 收件邮箱

# 钉钉群机器人（安全设置选「加签」时，把 SEC 开头的密钥填到 DINGTALK_SECRET）
DINGTALK_WEBHOOK=     # https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=      # 可选：SEC 开头，开了加签才需要
