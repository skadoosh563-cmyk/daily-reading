.page { padding: 24rpx 32rpx 60rpx; }

.hint { color: #8b949e; font-size: 28rpx; text-align: center; padding: 80rpx 0; }
.hint.error { color: #a32d2d; padding-bottom: 24rpx; }

.bar { display: flex; align-items: center; gap: 20rpx; margin-bottom: 28rpx; }
.bar-text { font-size: 26rpx; color: #57606a; min-width: 110rpx; }
.bar-track { flex: 1; height: 8rpx; background: #e8e6e0; border-radius: 4rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #185fa5; border-radius: 4rpx; }

.card {
  background: #fff; border-radius: 24rpx; padding: 60rpx 40rpx;
  min-height: 560rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.word { font-size: 60rpx; font-weight: 600; color: #1f2328; text-align: center; }
.phonetic { font-size: 30rpx; color: #57606a; margin-top: 12rpx; }
.pos { font-size: 26rpx; color: #8b949e; margin-top: 6rpx; }

.divider { width: 80rpx; height: 2rpx; background: #e3e2dd; margin: 36rpx 0; }
.meaning { font-size: 34rpx; color: #1f2328; text-align: center; line-height: 1.6; }
.example { margin-top: 40rpx; padding-top: 32rpx; border-top: 1rpx solid #eceae4; }
.ex-en { font-size: 28rpx; color: #24292f; line-height: 1.6; }
.ex-zh { font-size: 26rpx; color: #8b949e; margin-top: 10rpx; line-height: 1.6; }

.tap-hint { margin-top: 60rpx; font-size: 26rpx; color: #b0aea8; }

.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }

.act {
  flex: 1; border-radius: 20rpx; padding: 26rpx 0;
  text-align: center; background: #fff;
}
.act-key { font-size: 30rpx; font-weight: 500; }
.act-sub { font-size: 22rpx; color: #8b949e; margin-top: 6rpx; }
.act-again .act-key { color: #a32d2d; }
.act-hard .act-key { color: #854f0b; }
.act-good .act-key { color: #0f6e56; }

.btn {
  margin-top: 28rpx; background: #185fa5; color: #fff;
  font-size: 30rpx; border-radius: 16rpx; line-height: 88rpx;
}
.btn.ghost { background: #fff; color: #57606a; }

.done-wrap { padding-top: 100rpx; text-align: center; }
.done-mark {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #eaf3de; margin: 0 auto 32rpx; position: relative;
}
.done-mark::after {
  content: ""; position: absolute; left: 34rpx; top: 24rpx;
  width: 20rpx; height: 38rpx; border-right: 5rpx solid #639922;
  border-bottom: 5rpx solid #639922; transform: rotate(45deg);
}
.done-title { font-size: 40rpx; font-weight: 500; color: #1f2328; }
.done-count { font-size: 28rpx; color: #8b949e; margin-top: 14rpx; }

.stat-row { display: flex; gap: 20rpx; margin: 60rpx 0 20rpx; }
.stat { flex: 1; background: #fff; border-radius: 20rpx; padding: 28rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 500; color: #185fa5; }
.stat-label { font-size: 24rpx; color: #8b949e; margin-top: 6rpx; }
