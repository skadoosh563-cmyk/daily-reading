<view class="page">

  <view wx:if="{{loading}}" class="hint">正在加载…</view>
  <view wx:elif="{{error}}" class="hint error">{{error}}</view>

  <block wx:elif="{{item}}">
    <view class="title">{{item.title_zh}}</view>
    <view class="meta">
      <text wx:if="{{item.source}}">{{item.source}}</text>
      <text wx:if="{{item.level}}"> · {{item.level}}</text>
      <text wx:if="{{item.word_count}}"> · {{item.word_count}} 词</text>
    </view>

    <view class="summary" wx:if="{{item.summary}}">{{item.summary}}</view>

    <view class="tabs">
      <view class="tab {{tab === 'vocab' ? 'on' : ''}}" data-tab="vocab" bindtap="onTab">生词 {{item.vocab.length}}</view>
      <view class="tab {{tab === 'trans' ? 'on' : ''}}" data-tab="trans" bindtap="onTab">翻译</view>
      <view class="tab {{tab === 'gram' ? 'on' : ''}}" data-tab="gram" bindtap="onTab">长难句</view>
      <view class="tab {{tab === 'quiz' ? 'on' : ''}}" data-tab="quiz" bindtap="onTab">理解题</view>
    </view>

    <block wx:if="{{tab === 'vocab'}}">
      <view class="vcard" wx:for="{{item.vocab}}" wx:key="word">
        <view class="vhead">
          <text class="vword" data-w="{{item.word}}" bindtap="onSpeak">{{item.word}}</text>
          <text class="vpos" wx:if="{{item.pos}}">{{item.pos}}</text>
          <text class="vph" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
        </view>
        <view class="vmean">{{item.meaning_zh}}</view>
        <view class="vex" wx:if="{{item.example_en}}">{{item.example_en}}</view>
        <view class="vex-zh" wx:if="{{item.example_zh}}">{{item.example_zh}}</view>
      </view>
    </block>

    <block wx:elif="{{tab === 'trans'}}">
      <view class="seg" wx:for="{{item.translation}}" wx:key="idx">
        <view class="seg-en">{{item.en}}</view>
        <view class="seg-zh">{{item.zh}}</view>
      </view>
    </block>

    <block wx:elif="{{tab === 'gram'}}">
      <view class="gcard" wx:for="{{item.grammar}}" wx:key="sentence">
        <view class="gsen">{{item.sentence}}</view>
        <view class="gpoint" wx:if="{{item.point}}">结构：{{item.point}}</view>
        <view class="gexp">{{item.explain_zh}}</view>
      </view>
    </block>

    <block wx:elif="{{tab === 'quiz'}}">
      <view class="qcard" wx:for="{{item.questions}}" wx:key="q" data-idx="{{index}}" bindtap="onReveal">
        <view class="qq">{{index + 1}}. {{item.q}}</view>
        <view class="qview" wx:if="{{answers[index]}}">参考答案：{{item.a}}</view>
        <view class="qtap" wx:else>点击查看答案</view>
      </view>
    </block>
  </block>

</view>
