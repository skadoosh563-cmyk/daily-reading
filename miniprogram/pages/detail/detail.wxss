.page { padding: 32rpx 32rpx 80rpx; }

.hint { color: #8b949e; font-size: 28rpx; text-align: center; padding: 80rpx 0; }
.hint.error { color: #a32d2d; }

.title { font-size: 40rpx; font-weight: 600; color: #1f2328; line-height: 1.5; }
.meta { font-size: 24rpx; color: #8b949e; margin-top: 12rpx; }

.summary {
  background: #f7f6f2; border-radius: 18rpx; padding: 26rpx 28rpx;
  font-size: 28rpx; color: #24292f; line-height: 1.75; margin-top: 26rpx;
}

.tabs { display: flex; gap: 10rpx; margin: 36rpx 0 24rpx; }
.tab {
  flex: 1; text-align: center; font-size: 26rpx; color: #57606a;
  background: #fff; border-radius: 14rpx; padding: 18rpx 0;
}
.tab.on { background: #185fa5; color: #fff; }

.vcard, .gcard, .qcard {
  background: #fff; border-radius: 18rpx; padding: 28rpx; margin-bottom: 20rpx;
}
.vhead { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; }
.vword { font-size: 36rpx; font-weight: 600; color: #1f2328; }
.vpos { font-size: 22rpx; color: #57606a; background: #f1efe8; padding: 2rpx 12rpx; border-radius: 6rpx; }
.vph { font-size: 24rpx; color: #8b949e; }
.vmean { font-size: 28rpx; color: #1f2328; margin-top: 14rpx; line-height: 1.6; }
.vex { font-size: 26rpx; color: #57606a; margin-top: 16rpx; line-height: 1.65; }
.vex-zh { font-size: 25rpx; color: #8b949e; margin-top: 6rpx; line-height: 1.65; }

.seg { background: #fff; border-radius: 18rpx; padding: 28rpx; margin-bottom: 20rpx; }
.seg-en { font-size: 28rpx; color: #24292f; line-height: 1.75; }
.seg-zh { font-size: 28rpx; color: #1f2328; line-height: 1.75; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #f0eee8; }

.gsen { font-size: 28rpx; color: #1f2328; line-height: 1.7; font-weight: 500; }
.gpoint { font-size: 25rpx; color: #185fa5; margin-top: 14rpx; }
.gexp { font-size: 26rpx; color: #57606a; line-height: 1.75; margin-top: 10rpx; }

.qq { font-size: 28rpx; color: #1f2328; line-height: 1.7; }
.qview { font-size: 26rpx; color: #0f6e56; line-height: 1.7; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #f0eee8; }
.qtap { font-size: 25rpx; color: #b0aea8; margin-top: 14rpx; }
