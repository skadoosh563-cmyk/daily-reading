.page { padding: 32rpx 32rpx 60rpx; }

.head { margin-bottom: 32rpx; }
.head-title { font-size: 44rpx; font-weight: 600; color: #1f2328; }
.head-sub { font-size: 26rpx; color: #8b949e; margin-top: 8rpx; }

.stat-row { display: flex; gap: 18rpx; margin-bottom: 36rpx; }
.stat { flex: 1; background: #fff; border-radius: 20rpx; padding: 26rpx 0; text-align: center; }
.stat-num { font-size: 42rpx; font-weight: 500; color: #185fa5; }
.stat-label { font-size: 23rpx; color: #8b949e; margin-top: 6rpx; }

.hint { color: #8b949e; font-size: 28rpx; text-align: center; padding: 80rpx 20rpx; line-height: 1.7; }
.hint.error { color: #a32d2d; }

.item {
  background: #fff; border-radius: 22rpx; padding: 30rpx 30rpx 24rpx;
  margin-bottom: 24rpx;
}
.item-top { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.item-date { font-size: 24rpx; color: #8b949e; }
.tag {
  font-size: 21rpx; color: #57606a; background: #f1efe8;
  padding: 4rpx 14rpx; border-radius: 6rpx;
}
.tag-vocab { color: #0f6e56; background: #e1f5ee; }

.item-title { font-size: 34rpx; font-weight: 500; color: #1f2328; margin-top: 16rpx; line-height: 1.5; }
.item-sum {
  font-size: 26rpx; color: #57606a; line-height: 1.7; margin-top: 12rpx;
  display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 3; overflow: hidden;
}
.item-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f0eee8;
}
.item-source { font-size: 23rpx; color: #b0aea8; }
.item-link { font-size: 24rpx; color: #185fa5; }
